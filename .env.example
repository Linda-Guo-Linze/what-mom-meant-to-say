# Stable Demo is the default and requires no model request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Groq is OpenAI-compatible. Add only the server-side key when Live AI is enabled.
MODEL_API_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=
MODEL_NAME=openai/gpt-oss-120b

# Built-in safeguards: 3 Live requests/browser/day, 10/IP/hour, 100/site/day.
# Never place model credentials in a NEXT_PUBLIC_ variable.

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/dist/
/outputs/
/work/

# local source handoff (not part of the public competition repository)
/docs/reference-summary.md
/docs/references/
/scripts/extract_docx.py

# local editor state
/.cursor/
